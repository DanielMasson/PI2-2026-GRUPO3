# Firebase — copie este arquivo para `.env` e preencha os valores do console:
#   https://console.firebase.google.com/  →  Configurações do projeto → Seus aplicativos (Web)
#
# No Vite, somente variáveis prefixadas com VITE_ são expostas ao client-side.
# O apiKey NUNCA é segredo em apps Firebase de client (assim como S3, Stripe, etc.).
# Firestore/RealtimeDB precisam de regras de segurança — não confie apenas nesse arquivo.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
