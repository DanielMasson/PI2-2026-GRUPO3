rules_version = '2';

// Firestore security rules para o app de gestão pecuária.
// Modelo: cada usuário só lê/escreve sua própria subárvore em users/{uid}/...
// As 9 subcollections (animais, vacinas, cios, coberturas, prenhezes, partos,
// producao_leite, membros, propriedades) herdam a regra via {document=**}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
